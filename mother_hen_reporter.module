<?php

/**
 * @file
 * Procedural hook shims for Drupal < 11.1.
 *
 * On Drupal 11.1+ the #[Hook] methods in ReporterHooks are used and these
 * functions are skipped because of #[LegacyHook].
 */

declare(strict_types=1);

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\mother_hen_reporter\Hook\ReporterHooks;

/**
 * Implements hook_cron().
 */
#[LegacyHook]
function mother_hen_reporter_cron(): void {
  \Drupal::service(ReporterHooks::class)->cron();
}

/**
 * Implements hook_help().
 */
#[LegacyHook]
function mother_hen_reporter_help(string $route_name, RouteMatchInterface $route_match): ?string {
  return \Drupal::service(ReporterHooks::class)->help($route_name, $route_match);
}
